within OMLET;
package Examples

  annotation (Documentation(info="<html>
<p>This package contains several examples of power energy systems:</p>
<ul>
<li><b><span style=\"font-family: Arial;\"><a href=\"modelica://LEPSE.Examples.Simple_model_old\">Simple_model</a></span> -</b>the most commonly used concept in the study of dynamic stability, including synchronous machine, power transmission line and infinite power buses;</li>
<li><b><span style=\"font-family: Arial;\"><a href=\"modelica://LEPSE.Examples._3_maschine_scheme_old\">three_maschine_scheme</a></span></b> - model of a simple energy integration model used in bachelor&apos;s theses;</li>
<li><b><span style=\"font-family: Arial;\"><a href=\"modelica://LEPSE.Examples.KKT_diploma\">KKT</a></span></b> - The Kola-Karelian transit model, part of the Unified Energy System of North-West Russia, which extends the base class KKT_1.</li>
</ul>
<p><br>The image is downloaded from https://www.vecteezy.com/</p>
</html>"), Icon(graphics={Bitmap(extent={{-100,-94},{108,82}}, fileName=
              "modelica://OMLET/Images/vecteezy_energy-industry-production-with-a-power-plant-scene_2024259/1779_U1RVRElPIFBDIDE3MjAtMTE.jpg"),
          Bitmap(extent={{-170,-112},{182,118}}, fileName=
              "modelica://OMLET/Images/vecteezy_power-plant-icon-set-showing-nuclear-factory-cooling-tower_86183071/vecteezy_power-plant-icon-set-showing-nuclear-factory-cooling-tower_86183071.jpg")}));
end Examples;
